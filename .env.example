# Copy to .env. Real environment variables take precedence over this file.

# Database (RepoMind's own container, see compose.yaml)
REPOMIND_DATABASE_URL=postgresql://repomind:repomind@127.0.0.1:55432/repomind

# Embeddings run locally; the first use downloads the model into .models/
# REPOMIND_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Only for reproducing the evaluation: local clones of the two evaluated repositories, used by
# `repomind evaluate` and the gold label tests, which skip themselves while these are unset.
# REPOMIND_REPO_STOCKGUARD=C:\path\to\stockguard
# REPOMIND_REPO_SYNCNOTES=C:\path\to\syncnotes

# Optional LLM for `repomind ask`. Any OpenAI-compatible endpoint works.
# Without these variables `ask` returns sources only and never invents an answer.
# REPOMIND_LLM_BASE_URL=http://127.0.0.1:11535/v1
# REPOMIND_LLM_MODEL=qwen2.5:7b
# qwen2.5:3b also works, on less memory. It chose worse sources in the pilot and never declined.
# REPOMIND_LLM_API_KEY=

# Optional, for a machine with an NVIDIA GPU: the local model then runs partly on it.
# Search, the code view and indexing need no GPU, and the model works without one, more slowly.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.gpu.yaml

# Limits for repositories added by URL in the web app. These are the defaults.
# REPOMIND_INDEX_MAX_REPO_MB=300
# REPOMIND_INDEX_MAX_CLONE_MB=600
# REPOMIND_INDEX_MAX_FILES=20000
# REPOMIND_INDEX_MAX_INDEXABLE_FILES=5000
# REPOMIND_INDEX_MAX_SOURCE_MB=100
# REPOMIND_INDEX_CLONE_SECONDS=300
# REPOMIND_INDEX_TOTAL_SECONDS=1800
# Where those clones are kept. Defaults to .data in the project.
# REPOMIND_DATA_DIR=

# Sending repository code to a non-loopback endpoint must be enabled explicitly.
# REPOMIND_LLM_ALLOW_REMOTE=0

# How the model picks lines. "choose" (the default) shows it all passages in one request.
# "judge" is experimental: one request per passage, about three times slower, and not shown to be more accurate.
# REPOMIND_LLM_SELECTION=choose

# Experimental, and off unless set to 1. When the model chooses the declaration of a constant, and a line
# that uses the constant was offered and passes the evidence rule, both are shown: the declaration as the
# model's choice, and the use as a line RepoMind added. The link shows that one line refers to the other.
# It does not show that either answers the question, and on the two test repositories most declarations
# it could accept were not the right source. Leave it off for anything but an experiment.
# REPOMIND_LLM_LINKED_EVIDENCE=0

# Limits enforced before every request
# REPOMIND_LLM_MAX_CONTEXT_CHUNKS=12
# REPOMIND_LLM_MAX_INPUT_TOKENS=4000
# Per request. The reply is a short list of passage ids and at most one sentence.
# REPOMIND_LLM_MAX_OUTPUT_TOKENS=250
# REPOMIND_LLM_INPUT_USD_PER_MTOK=0
# REPOMIND_LLM_OUTPUT_USD_PER_MTOK=0
# REPOMIND_LLM_MAX_TOTAL_COST_USD=0
