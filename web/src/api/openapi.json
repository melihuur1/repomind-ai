{
 "components": {
  "schemas": {
   "AddRepositoryRequest": {
    "properties": {
     "url": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "AddRepositoryRequest",
    "type": "object"
   },
   "AiStatus": {
    "properties": {
     "detail": {
      "title": "Detail",
      "type": "string"
     },
     "endpoint": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The host of a remote model server. Never a key, and nothing for a local one.",
      "title": "Endpoint"
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "remote": {
      "default": false,
      "description": "The model runs on another machine: each question and the lines of code chosen for it are sent there.",
      "title": "Remote",
      "type": "boolean"
     },
     "state": {
      "enum": [
       "ready",
       "offline",
       "model_missing",
       "not_configured",
       "low_memory",
       "misconfigured",
       "auth_failed",
       "budget_reached",
       "limited",
       "rejected"
      ],
      "title": "State",
      "type": "string"
     }
    },
    "required": [
     "state",
     "detail"
    ],
    "title": "AiStatus",
    "type": "object"
   },
   "AskRequest": {
    "properties": {
     "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
     },
     "repo": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Repo",
      "type": "string"
     }
    },
    "required": [
     "repo",
     "question"
    ],
    "title": "AskRequest",
    "type": "object"
   },
   "AskResponse": {
    "properties": {
     "ai": {
      "$ref": "#/components/schemas/AiStatus"
     },
     "ai_used": {
      "title": "Ai Used",
      "type": "boolean"
     },
     "discarded": {
      "items": {
       "type": "string"
      },
      "title": "Discarded",
      "type": "array"
     },
     "experimental": {
      "const": true,
      "default": true,
      "title": "Experimental",
      "type": "boolean"
     },
     "input_tokens": {
      "title": "Input Tokens",
      "type": "integer"
     },
     "message": {
      "title": "Message",
      "type": "string"
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "model_reading": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The model's own sentence. It is unverified, and may be false.",
      "title": "Model Reading"
     },
     "model_reading_removed_because": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model Reading Removed Because"
     },
     "output_tokens": {
      "title": "Output Tokens",
      "type": "integer"
     },
     "reply_problem": {
      "anyOf": [
       {
        "enum": [
         "empty",
         "cut_off",
         "not_json",
         "no_choice_list",
         "not_offered",
         "no_judgement"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "With the verdict invalid_response, what was wrong with the model's reply. An invalid reply is neither an answer nor a refusal by the model, and it gives no source.",
      "title": "Reply Problem"
     },
     "seconds": {
      "title": "Seconds",
      "type": "number"
     },
     "sources": {
      "items": {
       "$ref": "#/components/schemas/AskSource"
      },
      "title": "Sources",
      "type": "array"
     },
     "translated_query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Translated Query"
     },
     "verdict": {
      "enum": [
       "lines_chosen",
       "not_enough_evidence",
       "invalid_response",
       "ai_unavailable"
