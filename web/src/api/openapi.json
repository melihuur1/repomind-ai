    "title": "AskResponse",
    "type": "object"
   },
   "AskSource": {
    "description": "Two checks that must not be confused. ``exists_in_git`` does not mean the lines answer the question.",
    "properties": {
     "answer_check": {
      "enum": [
       "passed",
       "failed",
       "not_made"
      ],
      "title": "Answer Check",
      "type": "string"
     },
     "commit": {
      "title": "Commit",
      "type": "string"
     },
     "end_line": {
      "title": "End Line",
      "type": "integer"
     },
     "exists_in_git": {
      "title": "Exists In Git",
      "type": "boolean"
     },
     "language": {
      "title": "Language",
      "type": "string"
     },
     "path": {
      "title": "Path",
      "type": "string"
     },
     "repo": {
      "title": "Repo",
      "type": "string"
     },
     "role": {
      "description": "answer: the model chose these lines and they were accepted. declaration: the model did not choose these lines. They declare a constant that chosen lines use, and RepoMind shows them so that the value is seen with the lines that name it. linked_use: the model did not choose these lines. RepoMind added them because they use a constant whose declaration the model chose. Only with the experimental linked evidence setting. review_candidate: the model chose these lines and the evidence rule turned them down. closest: the closest lines found, which nothing judged.",
      "enum": [
       "answer",
       "declaration",
       "linked_use",
       "review_candidate",
       "closest"
      ],
      "title": "Role",
      "type": "string"
     },
     "start_line": {
      "title": "Start Line",
      "type": "integer"
     },
     "symbol": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Symbol"
     },
     "text": {
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "role",
     "repo",
     "commit",
     "path",
     "language",
     "symbol",
     "start_line",
     "end_line",
     "text",
     "exists_in_git",
     "answer_check"
    ],
    "title": "AskSource",
    "type": "object"
   },
