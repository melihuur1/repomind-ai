 "info": {
  "title": "RepoMind AI",
  "version": "0.2.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/ask": {
   "post": {
    "operationId": "ask_api_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AskResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Ask"
   }
  },
  "/api/file": {
   "get": {
    "description": "The path is only ever compared with the database's list, and the content only ever comes from a Git object.",
    "operationId": "file_content_api_file_get",
    "parameters": [
     {
      "in": "query",
      "name": "repo",
      "required": true,
      "schema": {
       "maxLength": 200,
       "minLength": 1,
       "title": "Repo",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "path",
      "required": true,
      "schema": {
       "maxLength": 1024,
       "minLength": 1,
       "title": "Path",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "commit",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 40,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Commit"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FileContent"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "File Content"
   }
  },
  "/api/health": {
   "get": {
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Health"
   }
  },
  "/api/jobs": {
   "get": {
    "operationId": "list_jobs_api_jobs_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/IndexJob"
         },
         "title": "Response List Jobs Api Jobs Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "List Jobs"
   }
  },
  "/api/jobs/{job_id}": {
   "delete": {
    "description": "Clears a finished job's repository from the list. Whatever was indexed stays indexed.",
    "operationId": "dismiss_job_api_jobs__job_id__delete",
    "parameters": [
     {
      "in": "path",
      "name": "job_id",
      "required": true,
      "schema": {
       "title": "Job Id",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Dismiss Job"
   },
   "get": {
    "operationId": "get_job_api_jobs__job_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "job_id",
      "required": true,
      "schema": {
       "title": "Job Id",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/IndexJob"
        }
